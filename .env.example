# サーバーが待受するポート番号（省略時のデフォルト: 3000）
PORT=3000

# PostgreSQL (Neon) の接続文字列（Connection String）
# Neonのダッシュボードの「Connection Details」からコピーして設定してください。
# ※このファイル（.env.example）は設定例です。実際のパスワードを含む値は .env に記述してください。
DATABASE_URL=postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require
